# Copy to .env and fill in ONE provider key. With no key, the proxy runs in MOCK mode.
# Recommended for the demo: Gemini (cheap, fast, multimodal). Get a key at aistudio.google.com.

# PROVIDER=gemini            # gemini | openai | anthropic | mock | auto (default: auto-detect by key)
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Optional model overrides:
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-5
